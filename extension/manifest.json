{
  "manifest_version": 3,
  "name": "Tab Pet - Focus Guardian",
  "version": "1.0.0",
  "description": "Cute procedural desktop pet that sits on your tab bar and closes blocked tabs during Pomodoro focus sessions.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
